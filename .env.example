# ==============================================================
# AI Handwritten Notes Generator - Environment Configuration
# ==============================================================

# Application Configuration
APP_NAME="AI Handwritten Notes Generator"
APP_VERSION="1.0.0"
DEBUG=False

# OpenAI API Key Configuration
# Leave blank to operate in Offline Demo Mode (no API key required)
OPENAI_API_KEY=""

# Configurable OpenAI Model
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL="gpt-4o-mini"

# Demo Mode (Set to true to force simulated responses without charging API credits)
DEMO_MODE=true

# Database Connection (SQLite default for development)
DATABASE_URL="sqlite:///./handwritten_notes.db"

# Upload and Security Restrictions
MAX_FILE_SIZE_MB=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
