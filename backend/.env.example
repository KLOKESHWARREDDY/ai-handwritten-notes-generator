# Application Configuration
APP_NAME="AI Handwritten Notes Generator"
APP_VERSION="1.0.0"
DEBUG=False

# OpenAI API Key Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
DEMO_MODE=true

# Database Connection
DATABASE_URL="sqlite:///./handwritten_notes.db"

# Upload and Security Restrictions
MAX_FILE_SIZE_MB=15
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
